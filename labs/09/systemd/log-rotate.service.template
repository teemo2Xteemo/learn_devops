[Unit]
Description=Rotate lab 09 logs when they exceed size threshold
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory={{REPOS_DIR}}
ExecStart=/usr/bin/env bash {{REPOS_DIR}}/log-rotate.sh
User={{USER}}
Group={{GROUP}}
ProtectSystem=full
ProtectHome=false
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

